---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PortalNav from '../../components/portal/PortalNav.jsx';
import AdminProgressTable from '../../components/portal/AdminProgressTable.jsx';

const entries = await getCollection('courses', ({ data }) => data.modules && data.modules.length > 0);
const courses = entries.map(e => ({
  courseId: e.data.courseId || e.slug,
  title: e.data.title,
  totalLessons: e.data.modules.reduce((n, m) => n + m.lessons.length, 0),
}));
---
<Layout title="Student Progress | Green Orbit Academy Admin">
  <main class="mx-auto max-w-6xl px-4 py-12">
    <PortalNav client:load />
    <h1 class="mb-6 text-2xl font-bold">Student Progress</h1>
    <AdminProgressTable client:load courses={courses} />
  </main>
</Layout>
